<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunar_south_pole_gazebo</name>
  <version>0.1.0</version>
  <description>
    Stage-1 ROS 2 + Gazebo Sim backend for a Lunar South Pole rover
    simulator. Builds a heightmap world from a NASA PGDA LOLA DEM
    via GDAL + rasterio + Pillow; relies on ros_gz_bridge for ROS↔Gz
    topic bridging and on stock Gazebo sensor/diff-drive plugins.
    Reuse-first; no custom physics, raster, or bridge code.
  </description>
  <maintainer email="yyz513225677@gmail.com">Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>

  <!-- Bridge + Gazebo glue. exec_depend is enough — we don't build
       against ros_gz_bridge headers, just call its node from launch. -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
