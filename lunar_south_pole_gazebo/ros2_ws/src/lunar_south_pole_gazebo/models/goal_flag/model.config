<?xml version="1.0"?>
<model>
  <name>goal_flag</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>
    Vertical pole + cloth flag — spawned by mission_manager_node at
    each random goal point. The flag colour is overridden per-spawn
    via the `mission_manager` node's `flag_color` param.
  </description>
</model>
