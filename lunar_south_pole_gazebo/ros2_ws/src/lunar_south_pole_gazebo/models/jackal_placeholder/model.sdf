<?xml version="1.0"?>
<!--
  PLACEHOLDER rover. Four-wheel skid-steer, gz-sim diff-drive plugin,
  one gpu_lidar, one imu. Replace with the official Clearpath Jackal
  description once published for ROS 2 Jazzy.
-->
<sdf version="1.10">
  <model name="jackal_placeholder" canonical_link="base_link">

    <link name="base_link">
      <inertial>
        <mass>17.0</mass>
        <inertia>
          <ixx>0.5</ixx><iyy>1.0</iyy><izz>1.2</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_vis">
        <geometry><box><size>0.50 0.42 0.18</size></box></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.32 0.32 0.35 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_col">
        <geometry><box><size>0.50 0.42 0.18</size></box></geometry>
      </collision>

      <!-- 3D LiDAR (gpu_lidar) — 360° horizontal, 16 vertical rings,
           mimicking a Velodyne VLP-16 (Dreamer was trained on VLP-32;
           16 rings keeps gz-sim performance stable while still
           producing a real 3D point cloud).
           gz-sim auto-publishes BOTH:
             /lunar_jackal/scan         (gz.msgs.LaserScan, mid-ring)
             /lunar_jackal/scan/points  (gz.msgs.PointCloudPacked, all rings)
           Frame: lidar_link. -->
      <sensor name="lidar_link" type="gpu_lidar">
        <pose>0 0 0.18 0 0 0</pose>
        <topic>/lunar_jackal/scan</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle> 3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>   <!-- -15° -->
              <max_angle> 0.2618</max_angle>   <!-- +15° -->
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>80.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>

      <!-- IMU — 100 Hz, frame imu_link -->
      <sensor name="imu_link" type="imu">
        <pose>0 0 0.10 0 0 0</pose>
        <topic>/lunar_jackal/imu</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
      </sensor>

      <!-- Chase camera (racing-game third-person follow). Rigidly
           attached to base_link so the view tracks the robot without
           any custom transform code. Offsets / FOV come from
           config/chase_camera.yaml.
           Pose RPY convention: +pitch about Y axis (right-hand rule)
           rotates the camera's +X look-axis toward -Z, i.e. *downward*.
           pitch=+0.40 rad ≈ 23° downward, matching atan2(3 m, 6 m). -->
      <sensor name="chase_camera" type="camera">
        <pose>-6.0 0.0 3.0 0 0.40 0</pose>
        <topic>/lunar_jackal/chase_camera/image</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>500.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- Four wheels, two per side. Link frame is aligned with the model
         frame (no rotation in <pose>) so the joint axis 0,1,0 below is
         unambiguously the lateral Y axis. The cylinder geometry rotation
         lives inside the visual/collision <pose>, where it only affects
         rendering/contact and not the joint axis. -->
    <link name="wheel_fl">
      <pose>0.20  0.22 -0.08 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia>
          <ixx>0.003</ixx><iyy>0.005</iyy><izz>0.003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></visual>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></collision>
    </link>
    <link name="wheel_fr">
      <pose>0.20 -0.22 -0.08 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia>
          <ixx>0.003</ixx><iyy>0.005</iyy><izz>0.003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></visual>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></collision>
    </link>
    <link name="wheel_rl">
      <pose>-0.20  0.22 -0.08 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia>
          <ixx>0.003</ixx><iyy>0.005</iyy><izz>0.003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></visual>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></collision>
    </link>
    <link name="wheel_rr">
      <pose>-0.20 -0.22 -0.08 0 0 0</pose>
      <inertial><mass>0.5</mass>
        <inertia>
          <ixx>0.003</ixx><iyy>0.005</iyy><izz>0.003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="v"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></visual>
      <collision name="c"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder>
        <radius>0.10</radius><length>0.05</length>
      </cylinder></geometry></collision>
    </link>

    <joint name="j_fl" type="revolute">
      <parent>base_link</parent><child>wheel_fl</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="j_fr" type="revolute">
      <parent>base_link</parent><child>wheel_fr</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="j_rl" type="revolute">
      <parent>base_link</parent><child>wheel_rl</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
    <joint name="j_rr" type="revolute">
      <parent>base_link</parent><child>wheel_rr</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <!-- Stock Gazebo diff-drive plugin — drives left/right wheel pairs. -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>j_fl</left_joint>
      <left_joint>j_rl</left_joint>
      <right_joint>j_fr</right_joint>
      <right_joint>j_rr</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <topic>/lunar_jackal/cmd_vel</topic>
      <odom_topic>/lunar_jackal/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
