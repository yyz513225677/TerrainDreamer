<?xml version="1.0"?>
<model>
  <name>jackal_placeholder</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>lunar_south_pole_gazebo</name>
  </author>
  <description>
    PLACEHOLDER rover — a four-wheel skid-steer SDF with stock Gazebo
    Sim sensors and the gz-sim diff-drive plugin. Used because the
    official Clearpath Jackal description (`ros-${ROS_DISTRO}-jackal-description`)
    is not yet published for ROS 2 Jazzy.

    Replace this model by installing the official package — see the
    project README "Using the official Clearpath Jackal" section.
  </description>
</model>
